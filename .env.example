# -------- Supabase --------
# Project URL and keys: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — NEVER expose to the browser. Used only by the sync
# script and server-side auth-allowlist check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------- GitHub --------
# Fine-grained PAT, read-only, scoped to the org's repos:
# Contents: read, Pull requests: read, Metadata: read
GITHUB_TOKEN=github_pat_xxx
GITHUB_ORG=zopping

# Comma-separated repo names to skip syncing (archived/irrelevant repos)
GITHUB_IGNORED_REPOS=
