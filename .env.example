# -------- Supabase --------
# Project URL and keys: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — NEVER expose to the browser. Used by the sync job
# and every server action that needs to bypass RLS (creating an org,
# inviting teammates, linking a login to an invite).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------- App --------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protects /api/sync (the daily cron endpoint) from being triggered by
# anyone who finds the URL. Any random string.
CRON_SECRET=change-me

# Note: there's no global GITHUB_TOKEN/GITHUB_ORG here anymore — each
# organization connects its own GitHub org + token during onboarding
# (stored in the `organizations` table), since Commitly is multi-tenant.
